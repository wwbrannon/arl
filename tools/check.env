# environment variables that control the behavior of R CMD check, which we set
# to be as strict as possible so we can avoid more rounds of "submit, get niche
# CRAN error we didn't know to check for"
# see
# a) https://cran.r-project.org/doc/manuals/r-devel/R-ints.html and
# b) https://github.com/r-devel/r-dev-web/blob/main/CRAN/QA

R_USEMETHOD_FORWARD_LOCALS=error
R_KNITR_OPTIONS=knitr.chunk.optipng=\"-quiet\"

# run through even if errors, but exit unsuccessfully
_R_CHECK_NO_STOP_ON_TEST_ERROR_=true

# check if the package is already on CRAN; unavoidable NOTE if not; there's no
# reason to check for this because it's not a problem and we can't fix it
_R_CHECK_CRAN_INCOMING_REMOTE_=false

_R_CHECK_COMPACT_DATA2_=true
_R_CHECK_WINDOWS_DEVICE_=stop
_R_CHECK_SRC_MINUS_W_WARNINGS_=true
_R_CHECK_ELAPSED_TIMEOUT_=600
_R_CHECK_INSTALL_TIMEOUT_=600
_R_CHECK_TESTS_ELAPSED_TIMEOUT_=600
_R_CHECK_VIGNETTES_ELAPSED_TIMEOUT_=600
_R_CHECK_RD_CHECKRD_MINLEVEL_=0
_R_CHECK_ORPHANED_OVERWRITE_=true
_R_CALLS_INVALID_NUMERIC_VERSION_=true
_R_CHECK_ALL_NON_ISO_C_=true
_R_CHECK_ALWAYS_LOG_VIGNETTE_OUTPUT_=true
_R_CHECK_AUTOCONF_=true
_R_CHECK_BASHISMS_=true
_R_CHECK_BOGUS_RETURN_=true
_R_CHECK_BROWSER_NONINTERACTIVE_=true
_R_CHECK_BUILD_VIGNETTES_SEPARATELY_=false
_R_CHECK_CODETOOLS_PROFILE_="suppressPartialMatchArgs=false"
_R_CHECK_CODE_ASSIGN_TO_GLOBALENV_=true
_R_CHECK_CODE_ATTACH_=true
_R_CHECK_CODE_CLASS_IS_STRING_=true
_R_CHECK_CODE_DATA_INTO_GLOBALENV_=true
_R_CHECK_CODE_USAGE_VIA_NAMESPACES_=true
_R_CHECK_CODE_USAGE_WITHOUT_LOADING_=true
_R_CHECK_CODE_USAGE_WITH_ONLY_BASE_ATTACHED_=true
_R_CHECK_CODOC_VARIABLES_IN_USAGES_=true
_R_CHECK_COMPILATION_FLAGS_=true
_R_CHECK_CONNECTIONS_LEFT_OPEN_=true
_R_CHECK_CRAN_INCOMING_=true
_R_CHECK_CRAN_INCOMING_CHECK_FILE_URIS_=true
_R_CHECK_CRAN_INCOMING_CHECK_URLS_IN_PARALLEL_=true
_R_CHECK_CRAN_INCOMING_NOTE_GNU_MAKE_=true
_R_CHECK_CRAN_INCOMING_USE_ASPELL_=true
_R_CHECK_DATALIST_=true
_R_CHECK_DEPENDS_ONLY_DATA_=true
_R_CHECK_DEPRECATED_DEFUNCT_=true
_R_CHECK_DOC_SIZES2_=true
_R_CHECK_DONTTEST_EXAMPLES_=true
_R_CHECK_DOTCODE_RETVAL_=true
_R_CHECK_DOT_FIRSTLIB_=true
_R_CHECK_DOT_INTERNAL_=true
_R_CHECK_EXAMPLE_TIMING_CPU_TO_ELAPSED_THRESHOLD_=2.5
_R_CHECK_EXAMPLE_TIMING_THRESHOLD_=5
_R_CHECK_EXCESSIVE_IMPORTS_=20
_R_CHECK_EXECUTABLES_EXCLUSIONS_=true
_R_CHECK_FF_AS_CRAN_=true
_R_CHECK_FF_CALLS_=registration
_R_CHECK_FF_DUP_=true
_R_CHECK_FORCE_SUGGESTS_=true
_R_CHECK_FUTURE_FILE_TIMESTAMPS_=true
_R_CHECK_FUTURE_FILE_TIMESTAMPS_LEEWAY_=6h
_R_CHECK_INSTALL_DEPENDS_=true
_R_CHECK_INSTALL_TIMING_CPU_TO_ELAPSED_THRESHOLD_=2.5
_R_CHECK_LENGTH_1_CONDITION_=abort,verbose
_R_CHECK_LENGTH_1_LOGIC2_=abort,verbose
_R_CHECK_LICENSE_=true
_R_CHECK_LIMIT_CORES_=true
_R_CHECK_LOG_USE_INFO_=true
_R_CHECK_MATRIX_DATA_=true
_R_CHECK_MBCS_CONVERSION_FAILURE_=true
_R_CHECK_NATIVE_ROUTINE_REGISTRATION_=true
_R_CHECK_NEWS_IN_PLAIN_TEXT_=true
_R_CHECK_NO_RECOMMENDED_=true
_R_CHECK_ORPHANED_=true
_R_CHECK_OVERWRITE_REGISTERED_S3_METHODS_=true
_R_CHECK_PACKAGES_USED_CRAN_INCOMING_NOTES_=true
_R_CHECK_PACKAGES_USED_IGNORE_UNUSED_IMPORTS_=true
_R_CHECK_PACKAGES_USED_IN_DEMO_=true
_R_CHECK_PACKAGES_USED_IN_TESTS_USE_SUBDIRS_=true
_R_CHECK_PACKAGE_DATASETS_SUPPRESS_NOTES_=true
_R_CHECK_PKG_SIZES_=true
_R_CHECK_PKG_SIZES_THRESHOLD_=5
_R_CHECK_PRAGMAS_=true
_R_CHECK_RD_CONTENTS_KEYWORDS_=true
_R_CHECK_RD_EXAMPLES_T_AND_F_=true
_R_CHECK_RD_LINE_WIDTHS_=true
_R_CHECK_RD_MATH_RENDERING_=true
_R_CHECK_RD_NOTE_LOST_BRACES_=true
_R_CHECK_RD_VALIDATE_RD2HTML_=true
_R_CHECK_RD_VALIDATE_RD2HTML_IGNORE_EMPTY_SPANS_=true
_R_CHECK_REPLACING_IMPORTS_=true
_R_CHECK_R_DEPENDS_=warn
_R_CHECK_R_ON_PATH_=true
_R_CHECK_S3_METHODS_NOT_REGISTERED_=true
_R_CHECK_S3_METHODS_SHOW_POSSIBLE_ISSUES_=true
_R_CHECK_SCREEN_DEVICE_=stop
_R_CHECK_SERIALIZATION_=true
_R_CHECK_SHLIB_OPENMP_FLAGS_=true
_R_CHECK_SRC_CATCH_ARMADILLO_FALLBACK_COMPILATION_MESSAGE_=true
_R_CHECK_SRC_MINUS_W_IMPLICIT_=true
_R_CHECK_STOP_ON_INVALID_NUMERIC_VERSION_INPUTS_=true
_R_CHECK_SUBDIRS_NOCASE_=true
_R_CHECK_SUGGESTS_ONLY_=true
_R_CHECK_SYSTEM_CLOCK_=false
_R_CHECK_TESTS_NLINES_=0
_R_CHECK_TEST_TIMING_=yes
_R_CHECK_TEST_TIMING_CPU_TO_ELAPSED_THRESHOLD_=2.5
_R_CHECK_THINGS_IN_CHECK_DIR_=true
_R_CHECK_THINGS_IN_OTHER_DIRS_=true
_R_CHECK_THINGS_IN_TEMP_DIR_=true
_R_CHECK_TIMINGS_=10
_R_CHECK_TOPLEVEL_FILES_=true
_R_CHECK_UNDOC_USE_ALL_NAMES_=true
_R_CHECK_UNSAFE_CALLS_=true
_R_CHECK_URLS_SHOW_301_STATUS_=true
_R_CHECK_VALIDATE_UTF8_=true
_R_CHECK_VC_DIRS_=true
_R_CHECK_VIGNETTES_NLINES_=10000
_R_CHECK_VIGNETTES_SKIP_RUN_MAYBE_=true
_R_CHECK_VIGNETTE_TIMING_=yes
_R_CHECK_VIGNETTE_TIMING_CPU_TO_ELAPSED_THRESHOLD_=2.5
_R_CHECK_VIGNETTE_TITLES_=true
_R_CHECK_XREFS_MIND_SUSPECT_ANCHORS_=true
_R_CHECK_XREFS_NOTE_MISSING_PACKAGE_ANCHORS_=true
_R_CHECK_XREFS_PKGS_ARE_DECLARED_=true
_R_CHECK_XREFS_USE_ALIASES_FROM_CRAN_=true
_R_GC_FAIL_ON_ERROR_=true
_R_S3_METHOD_LOOKUP_BASEENV_AFTER_GLOBALENV_=true
_R_SHLIB_BUILD_OBJECTS_SYMBOL_TABLES_=true
